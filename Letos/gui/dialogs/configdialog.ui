         <widget class="QWidget" name="databaseListPage">
          <layout class="QVBoxLayout" name="verticalLayout_36">
           <item>
            <widget class="QGroupBox" name="dbListGroup">
             <property name="title">
              <string>Database list</string>
             </property>
             <layout class="QGridLayout" name="gridLayout">
              <item row="6" column="0">
               <widget class="QCheckBox" name="dispSystemTablesCheck">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;By default, system tables and indexes are hidden from the list.&lt;br/&gt;Enable this option to display internal SQLite objects, such as &lt;span style=&quot; font-family:'Courier New';&quot;&gt;sqlite_schema&lt;/span&gt; and auto-generated indexes.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Display system tables and indexes on the list</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.ShowSystemObjects</string>
                </property>
               </widget>
              </item>
              <item row="8" column="0">
               <widget class="QCheckBox" name="prefMasterOverSchemaCheck">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;By default, the database schema is accessed using the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;sqlite_schema&lt;/span&gt; table name.&lt;br/&gt;Older SQLite versions used the &lt;span style=&quot; font-family:'Courier New';&quot;&gt;sqlite_master&lt;/span&gt; name, which is still supported as an alias.&lt;br/&gt;You can switch here to use the legacy name instead.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Prefer sqlite_master over sqlite_schema table name</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">General.PreferMasterOverSchema</string>
                </property>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QCheckBox" name="expandTablesCheck">
                <property name="text">
                 <string>Expand tables when connected to a database</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.ExpandTables</string>
                </property>
               </widget>
              </item>
              <item row="3" column="0">
               <widget class="QCheckBox" name="expandColsIdxTrigCheck">
                <property name="toolTip">
                 <string>Expanding a table or view also expands the Columns, Indexes and Triggers nodes to show their contents.</string>
                </property>
                <property name="text">
                 <string>Expand columns, indexes and triggers together with the table</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.ExpandSubNodes</string>
                </property>
               </widget>
              </item>
              <item row="2" column="0">
               <widget class="QCheckBox" name="expandViewsCheck">
                <property name="text">
                 <string>Expand views when connected to a database</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.ExpandViews</string>
                </property>
               </widget>
              </item>
              <item row="5" column="0">
               <widget class="QCheckBox" name="sortColumns">
                <property name="toolTip">
                 <string>If switched off, then columns will be sorted in the order they are typed in CREATE TABLE statement.</string>
                </property>
                <property name="text">
                 <string>Sort table columns alphabetically</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.SortColumns</string>
                </property>
               </widget>
              </item>
              <item row="4" column="0">
               <widget class="QCheckBox" name="sortObjects">
                <property name="toolTip">
                 <string>If this option is switched off, then objects will be sorted in order they appear in sqlite_master table (which is in order they were created)</string>
                </property>
                <property name="text">
                 <string>Sort objects (tables, indexes, triggers and views) alphabetically</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.SortObjects</string>
                </property>
               </widget>
              </item>
              <item row="9" column="0">
               <widget class="QGroupBox" name="addLabelsGroup">
                <property name="toolTip">
                 <string>&lt;p&gt;Additional labels are those displayed next to the names on the databases list (they are blue, unless configured otherwise). Enabling this option will result in labels for databases, invalid databases and aggregated nodes (column group, index group, trigger group). For more labels see options below.&lt;p&gt;</string>
                </property>
                <property name="title">
                 <string>Display additional labels on the list</string>
                </property>
                <property name="checkable">
                 <bool>true</bool>
                </property>
                <property name="checked">
                 <bool>false</bool>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.ShowDbTreeLabels</string>
                </property>
                <layout class="QVBoxLayout" name="verticalLayout_20">
                 <item>
                  <widget class="QCheckBox" name="columnTypeLabelsCheck">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Shows data type next to the column when Columns node is expanded.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="text">
                    <string>Display column data types</string>
                   </property>
                   <property name="cfg" stdset="0">
                    <string notr="true">DbList.ShowColumnTypeLabels</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="regularTableLabelsCheck">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Shows number of columns, indexes and triggers next to each table name.&lt;/p&gt;&lt;p&gt;Requires loading full schema for all tables. For databases with hundreds or thousands of tables, this can significantly impact performance.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="text">
                    <string>Display labels for regular tables</string>
                   </property>
                   <property name="cfg" stdset="0">
                    <string notr="true">DbList.ShowRegularTableLabels</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="virtTableLabelsCheck">
                   <property name="toolTip">
                    <string>Virtual tables will be marked with a 'virtual' label.</string>
                   </property>
                   <property name="text">
                    <string>Display labels for virtual tables</string>
                   </property>
                   <property name="cfg" stdset="0">
                    <string notr="true">DbList.ShowVirtualTableLabels</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item row="7" column="0">
               <widget class="QCheckBox" name="showShadowTablesCheck">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Show shadow tables used internally by virtual tables in the database list. When hidden, they remain accessible through their associated virtual tables.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Show shadow tables on the list</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.ShowShadowTables</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QGroupBox" name="dbDialogGroup">
             <property name="title">
              <string>Database dialog window</string>
             </property>
             <layout class="QVBoxLayout" name="verticalLayout_37">
              <item>
               <widget class="QCheckBox" name="dontMarkDbAsDefaultCheck">
                <property name="toolTip">
                 <string>&lt;p&gt;When adding new database it is marked to be &quot;permanent&quot; (stored in configuration) by default. Checking this option makes every new database to NOT be &quot;permanent&quot; by default.&lt;/p&gt;</string>
                </property>
                <property name="text">
                 <string>Do not mark database to be &quot;permanent&quot; by default</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.NewDbNotPermanentByDefault</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="bypassDbDialogCheck">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;When enabled, database files will be added without showing the standard database dialog. If opening the database with default options fails (e.g. encrypted database or different driver required), the dialog will be shown so the options can be adjusted. When disabled, the dialog will always be shown.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Skip the dialog when possible</string>
                </property>
                <property name="cfg" stdset="0">
                 <string notr="true">DbList.BypassDbDialogWhenPossible</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <spacer name="verticalSpacer_4">
             <property name="orientation">
